# Xray Panel - environment configuration
# Copy this file to .env and adjust values before first run.

# Secret key for signing sessions and tokens (generate a strong random value)
SECRET_KEY=change-me-to-a-strong-random-secret

# Panel HTTP port
PANEL_PORT=8080

# URL path prefix for the panel (e.g. "/panel" or "/")
PANEL_PATH=/

# Default admin username (used only on first setup if no admin exists)
DEFAULT_ADMIN_USERNAME=admin

# SQLite database file path (relative to project root)
DATABASE_URL=sqlite:///./xray_panel.db

# Xray binary path (set in later phases)
XRAY_BIN_PATH=/usr/local/bin/xray

# Xray config file path (used by config generation/apply)
XRAY_CONFIG_PATH=/usr/local/etc/xray/config.json

# systemd unit name for Xray control from the dashboard (Phase 5)
XRAY_SERVICE_NAME=xray

# --- Phase 6: subscriptions / backup / telegram / ssl ----------------------
# (subscriptions and backup need no config; tokens/CSRF protect them)

# Optional Telegram bot — runs separately from the panel:
#   venv/bin/python -m app.telegram_bot
# Get a token from @BotFather; TELEGRAM_CHAT_ID restricts who may use it
# (leave empty to let the first /start become the owner).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# HTTPS is handled by uvicorn flags or a reverse proxy, e.g.:
#   uvicorn app.main:app --host 0.0.0.0 --port 8080 \
#     --ssl-certfile /etc/letsencrypt/live/domain/fullchain.pem \
#     --ssl-keyfile  /etc/letsencrypt/live/domain/privkey.pem
# (see README "HTTPS" section; the install script wires a systemd unit)

# --- Phase 4: traffic monitoring -------------------------------------------
# Enable the gRPC stats API section in generated config.json (recommended).
XRAY_STATS_ENABLED=1
# Localhost address of the dokodemo-door "api" inbound in config.json.
XRAY_API_HOST=127.0.0.1
XRAY_API_PORT=23231

# Background traffic sweep interval in seconds; 0 = off (manual refresh
# button in the client list). Example: 60 for a sweep every minute.
MONITOR_INTERVAL_SECONDS=0
